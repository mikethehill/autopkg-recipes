<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the latest macOS build of cli53 from its GitHub releases page. Defaults to the Apple Silicon (arm64) binary; set the ARCH input to "amd64" for Intel Macs.
 
cli53 is published as a bare, unsigned Go executable (no archive, no Developer ID signature), so there is no code signature to verify.</string>
	<key>Identifier</key>
	<string>com.github.techahoy.download.cli53</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>cli53</string>
		<key>ARCH</key>
		<string>arm64</string>
		<key>GITHUB_REPO</key>
		<string>barnybug/cli53</string>
	</dict>
	<key>MinimumVersion</key>
	<string>1.0.0</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Processor</key>
			<string>GitHubReleasesInfoProvider</string>
			<key>Arguments</key>
			<dict>
				<key>github_repo</key>
				<string>%GITHUB_REPO%</string>
				<key>asset_regex</key>
				<string>^cli53-mac-%ARCH%$</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>URLDownloader</string>
			<key>Arguments</key>
			<dict>
				<key>filename</key>
				<string>%NAME%-mac-%ARCH%</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>EndOfCheckPhase</string>
		</dict>
	</array>
</dict>
</plist>