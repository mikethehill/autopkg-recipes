<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the latest WiFiman Desktop installer package from Ubiquiti.

Ubiquiti publish separate packages per architecture. Set ARCH to "arm64" (Apple silicon, default) or "amd64" (Intel). The version and URL are read from Ubiquiti's macOS update manifest, which is what ui.com/download uses; the static HTML on that page lags behind.</string>
	<key>Identifier</key>
	<string>com.github.techahoy.download.WiFimanDesktop</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>WiFimanDesktop</string>
		<key>ARCH</key>
		<string>arm64</string>
		<key>MANIFEST_URL</key>
		<string>https://desktop.wifiman.com/wifiman-desktop-macos-manifest.json</string>
	</dict>
	<key>MinimumVersion</key>
	<string>2.3</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Processor</key>
			<string>URLTextSearcher</string>
			<key>Arguments</key>
			<dict>
				<key>url</key>
				<string>%MANIFEST_URL%</string>
				<key>re_pattern</key>
				<string>"(?P&lt;url&gt;https://desktop\.wifiman\.com/wifiman-desktop-(?P&lt;version&gt;[0-9][0-9.]*)-%ARCH%\.pkg)"</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>URLDownloader</string>
			<key>Arguments</key>
			<dict>
				<key>url</key>
				<string>%url%</string>
				<key>filename</key>
				<string>%NAME%-%version%-%ARCH%.pkg</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>EndOfCheckPhase</string>
		</dict>
		<dict>
			<key>Processor</key>
			<string>CodeSignatureVerifier</string>
			<key>Arguments</key>
			<dict>
				<key>input_path</key>
				<string>%pathname%</string>
				<key>expected_authority_names</key>
				<array>
					<string>Developer ID Installer: Ubiquiti Inc. (4P645293E8)</string>
					<string>Developer ID Certification Authority</string>
					<string>Apple Root CA</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
